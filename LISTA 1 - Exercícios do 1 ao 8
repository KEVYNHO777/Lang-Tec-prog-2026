#include <stdio.h>
#include <math.h>

int main() {

    /* EXERCICIO 1 */
    int n1, n2;

    printf("EXERCICIO 1\n");
    printf("Digite dois numeros inteiros: ");
    scanf("%d %d", &n1, &n2);

    printf("Ordem inversa: %d %d\n\n", n2, n1);


    /* EXERCICIO 2 */
    double valor;

    printf("EXERCICIO 2\n");
    printf("Digite um valor positivo: ");
    scanf("%lf", &valor);

    printf("Notacao cientifica: %e\n\n", valor);


    /* EXERCICIO 3 */
    int n;

    printf("EXERCICIO 3\n");
    printf("Digite um numero de 1 a 64: ");
    scanf("%d", &n);

    printf("Binario: ");

    if (n >= 64) {
        printf("1");
        n = n - 64;
    }

    if (n >= 32) {
        printf("1");
        n = n - 32;
    } else if (n >= 0) {
        printf("0");
    }

    if (n >= 16) {
        printf("1");
        n = n - 16;
    } else {
        printf("0");
    }

    if (n >= 8) {
        printf("1");
        n = n - 8;
    } else {
        printf("0");
    }

    if (n >= 4) {
        printf("1");
        n = n - 4;
    } else {
        printf("0");
    }

    if (n >= 2) {
        printf("1");
        n = n - 2;
    } else {
        printf("0");
    }

    if (n >= 1) {
        printf("1");
    } else {
        printf("0");
    }

    printf("\n\n");


    /* EXERCICIO 4 */
    double salario, vendas, total;

    printf("EXERCICIO 4\n");
    printf("Digite o salario fixo: ");
    scanf("%lf", &salario);

    printf("Digite o total de vendas: ");
    scanf("%lf", &vendas);

    total = salario + (vendas * 0.15);

    printf("TOTAL = R$ %.2f\n\n", total);


    /* EXERCICIO 5 */
    double a, b, c, d;
    double soma, media, produto;

    printf("EXERCICIO 5\n");
    printf("Digite quatro valores: ");
    scanf("%lf %lf %lf %lf", &a, &b, &c, &d);

    soma = a + b + c + d;
    media = soma / 4;
    produto = a * b * c * d;

    printf("Soma = %.2f\n", soma);
    printf("Media = %.2f\n", media);
    printf("Produto = %.2f\n\n", produto);


    /* EXERCICIO 6 */
    int dias, anos, meses, dias_restantes;

    printf("EXERCICIO 6\n");
    printf("Digite a idade em dias: ");
    scanf("%d", &dias);

    anos = dias / 365;
    dias_restantes = dias % 365;
    meses = dias_restantes / 30;
    dias_restantes = dias_restantes % 30;

    printf("%d anos\n", anos);
    printf("%d meses\n", meses);
    printf("%d dias\n\n", dias_restantes);


    /* EXERCICIO 7 */
    double raio, volume;
    double pi = 3.14159;

    printf("EXERCICIO 7\n");
    printf("Digite o raio da esfera: ");
    scanf("%lf", &raio);

    volume = (4.0 / 3.0) * pi * raio * raio * raio;

    printf("VOLUME = %.3f\n\n", volume);


    /* EXERCICIO 8 */
    double x1, y1, x2, y2;
    double distancia;

    printf("EXERCICIO 8\n");
    printf("Digite x1 e y1: ");
    scanf("%lf %lf", &x1, &y1);

    printf("Digite x2 e y2: ");
    scanf("%lf %lf", &x2, &y2);

    distancia = sqrt((x2 - x1) * (x2 - x1)
                   + (y2 - y1) * (y2 - y1));

    printf("DISTANCIA = %.4f\n", distancia);


    return 0;
}
