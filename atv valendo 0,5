   Numeros consecutivos
   ========================================================= */

void prova1_questao1()
{
    int n1, n2, n3, n4, n5;

    printf("\n===== PROVA 1 - QUESTAO 1 =====\n");

    printf("Digite o 1 numero: ");
    scanf("%d", &n1);

    printf("Digite o 2 numero: ");
    scanf("%d", &n2);

    printf("Digite o 3 numero: ");
    scanf("%d", &n3);

    printf("Digite o 4 numero: ");
    scanf("%d", &n4);

    printf("Digite o 5 numero: ");
    scanf("%d", &n5);

    printf("\nNumeros consecutivos encontrados:\n");

    if (n2 == n1 + 1)
        printf("%d %d\n", n1, n2);

    if (n3 == n2 + 1)
        printf("%d %d\n", n2, n3);

    if (n4 == n3 + 1)
        printf("%d %d\n", n3, n4);

    if (n5 == n4 + 1)
        printf("%d %d\n", n4, n5);
}


/* =========================================================
   PROVA 1 - QUESTAO 2
   IMC
   ========================================================= */

void prova1_questao2()
{
    float peso, altura, imc;

    printf("\n===== PROVA 1 - QUESTAO 2 =====\n");

    printf("Digite seu peso em kg: ");
    scanf("%f", &peso);

    printf("Digite sua altura em metros: ");
    scanf("%f", &altura);

    if (altura <= 0)
    {
        printf("Altura invalida.\n");
        return;
    }

    imc = peso / (altura * altura);

    printf("\nIMC: %.2f\n", imc);

    if (imc < 18.5)
    {
        printf("Classificacao: Abaixo do peso\n");
    }
    else if (imc <= 24.9)
    {
        printf("Classificacao: Normal\n");
    }
    else if (imc <= 29.9)
    {
        printf("Classificacao: Acima do peso\n");
    }
    else
    {
        printf("Classificacao: Obeso\n");
    }
}


/* =========================================================
   PROVA 1 - QUESTAO 3
   Torre de Hanoi
   ========================================================= */

void mostrarPinos(int pinoA[], int pinoB[], int pinoC[],
                  int qtdA, int qtdB, int qtdC)
{
    int i;

    printf("A: ");

    for (i = 0; i < qtdA; i++)
        printf("%d ", pinoA[i]);

    printf("\nB: ");

    for (i = 0; i < qtdB; i++)
        printf("%d ", pinoB[i]);

    printf("\nC: ");

    for (i = 0; i < qtdC; i++)
        printf("%d ", pinoC[i]);

    printf("\n");
}


void moverDisco(int origem, int destino,
                int pinoA[], int pinoB[], int pinoC[],
                int *qtdA, int *qtdB, int *qtdC)
{
    int disco;

    if (origem == 1)
    {
        disco = pinoA[*qtdA - 1];
        *qtdA = *qtdA - 1;
    }
    else if (origem == 2)
    {
        disco = pinoB[*qtdB - 1];
        *qtdB = *qtdB - 1;
    }
    else
    {
        disco = pinoC[*qtdC - 1];
        *qtdC = *qtdC - 1;
    }

    if (destino == 1)
    {
        pinoA[*qtdA] = disco;
        *qtdA = *qtdA + 1;
    }
    else if (destino == 2)
    {
        pinoB[*qtdB] = disco;
        *qtdB = *qtdB + 1;
    }
    else
    {
        pinoC[*qtdC] = disco;
        *qtdC = *qtdC + 1;
    }

    printf("Mover disco %d: %d -> %d\n",
           disco, origem, destino);

    mostrarPinos(pinoA, pinoB, pinoC,
                 *qtdA, *qtdB, *qtdC);
}


void hanoi(int disco, int origem, int destino, int auxiliar,
           int pinoA[], int pinoB[], int pinoC[],
           int *qtdA, int *qtdB, int *qtdC)
{
    if (disco == 1)
    {
        moverDisco(origem, destino,
                   pinoA, pinoB, pinoC,
                   qtdA, qtdB, qtdC);
    }
    else
    {
        hanoi(disco - 1, origem, auxiliar, destino,
              pinoA, pinoB, pinoC,
              qtdA, qtdB, qtdC);

        moverDisco(origem, destino,
                   pinoA, pinoB, pinoC,
                   qtdA, qtdB, qtdC);

        hanoi(disco - 1, auxiliar, destino, origem,
              pinoA, pinoB, pinoC,
              qtdA, qtdB, qtdC);
    }
}


void prova1_questao3()
{
    int pinoA[3] = {3, 2, 1};
    int pinoB[3] = {0};
    int pinoC[3] = {0};

    int qtdA = 3;
    int qtdB = 0;
    int qtdC = 0;

    printf("\n===== PROVA 1 - QUESTAO 3 =====\n");

    printf("\nEstado inicial:\n");

    mostrarPinos(pinoA, pinoB, pinoC,
                 qtdA, qtdB, qtdC);

    printf("\nOperacoes necessarias:\n\n");

    hanoi(3, 1, 3, 2,
          pinoA, pinoB, pinoC,
          &qtdA, &qtdB, &qtdC);

    printf("\nEstado final:\n");

    mostrarPinos(pinoA, pinoB, pinoC,
                 qtdA, qtdB, qtdC);
}


