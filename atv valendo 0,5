/* =========================================================
   PROVA 3 - QUESTAO 2
   Tres numeros distintos em ordem crescente
   ========================================================= */

void prova3_questao2()
{
    int a, b, c, aux;

    printf("\n===== PROVA 3 - QUESTAO 2 =====\n");

    printf("Digite o valor de a: ");
    scanf("%d", &a);

    printf("Digite o valor de b: ");
    scanf("%d", &b);

    printf("Digite o valor de c: ");
    scanf("%d", &c);

    if (a == b || a == c || b == c)
    {
        printf("Os numeros tem que ser distintos.\n");
    }
    else
    {
        if (a > b)
        {
            aux = a;
            a = b;
            b = aux;
        }

        if (a > c)
        {
            aux = a;
            a = c;
            c = aux;
        }

        if (b > c)
        {
            aux = b;
            b = c;
            c = aux;
        }

        printf("Ordem crescente: %d %d %d\n",
               a, b, c);
    }
}


/* =========================================================
   PROVA 3 - QUESTAO 3
   Operacoes relacionais
   ========================================================= */

void prova3_questao3()
{
    float valor1, valor2;
    int codigo;

    printf("\n===== PROVA 3 - QUESTAO 3 =====\n");

    printf("Digite o primeiro valor: ");
    scanf("%f", &valor1);

    printf("Digite o segundo valor: ");
    scanf("%f", &valor2);

    printf("\n1 - Maior que (>)\n");
    printf("2 - Menor que (<)\n");
    printf("3 - Igual a (==)\n");
    printf("4 - Diferente de (!=)\n");

    printf("\nDigite o codigo da operacao: ");
    scanf("%d", &codigo);

    switch (codigo)
    {
        case 1:
            if (valor1 > valor2)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");
            break;

        case 2:
            if (valor1 < valor2)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");
            break;

        case 3:
            if (valor1 == valor2)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");
            break;

        case 4:
            if (valor1 != valor2)
                printf("Verdadeiro\n");
            else
                printf("Falso\n");
            break;

        default:
            printf("Operador invalido.\n");
    }
}


