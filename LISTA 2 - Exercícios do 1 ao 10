#include <stdio.h>
#include <stdlib.h>

int main() {

    /* EXERCICIO 1 */
    int idade, anoAtual, anoNascimento;

    printf("EXERCICIO 1\n");
    printf("Digite sua idade: ");
    scanf("%d", &idade);

    printf("Digite o ano atual: ");
    scanf("%d", &anoAtual);

    anoNascimento = anoAtual - idade;

    printf("Ano de nascimento: %d\n\n", anoNascimento);


    /* EXERCICIO 2 */
    float kmh, ms;

    printf("EXERCICIO 2\n");
    printf("Digite a velocidade em km/h: ");
    scanf("%f", &kmh);

    ms = kmh / 3.6;

    printf("Velocidade em m/s: %.2f\n\n", ms);


    /* EXERCICIO 3 */
    float reais, cotacao, dolares;

    printf("EXERCICIO 3\n");
    printf("Digite o valor em reais: ");
    scanf("%f", &reais);

    printf("Digite a cotacao do dolar: ");
    scanf("%f", &cotacao);

    dolares = reais / cotacao;

    printf("Valor em dolares: %.2f\n\n", dolares);


    /* EXERCICIO 4 */
    float celsius, fahrenheit;

    printf("EXERCICIO 4\n");
    printf("Digite a temperatura em Celsius: ");
    scanf("%f", &celsius);

    fahrenheit = celsius * (9.0 / 5.0) + 32.0;

    printf("Temperatura em Fahrenheit: %.2f\n\n", fahrenheit);


    /* EXERCICIO 5 */
    float graus, radianos;
    float p = 3.141592;

    printf("EXERCICIO 5\n");
    printf("Digite o angulo em graus: ");
    scanf("%f", &graus);

    radianos = graus * p / 180;

    printf("Angulo em radianos: %.6f\n\n", radianos);


    /* EXERCICIO 6 */
    int numero;

    printf("EXERCICIO 6\n");
    printf("Digite um numero inteiro: ");
    scanf("%d", &numero);

    printf("Antecessor: %d\n", numero - 1);
    printf("Sucessor: %d\n\n", numero + 1);


    /* EXERCICIO 7 */
    float premio = 780000.00;
    float ganhador1, ganhador2, ganhador3;

    printf("EXERCICIO 7\n");

    ganhador1 = premio * 0.46;
    ganhador2 = premio * 0.32;
    ganhador3 = premio - ganhador1 - ganhador2;

    printf("Primeiro ganhador: R$ %.2f\n", ganhador1);
    printf("Segundo ganhador: R$ %.2f\n", ganhador2);
    printf("Terceiro ganhador: R$ %.2f\n\n", ganhador3);


    /* EXERCICIO 8 */
    int segundos, horas, minutos, segundosRestantes;

    printf("EXERCICIO 8\n");
    printf("Digite o tempo em segundos: ");
    scanf("%d", &segundos);

    horas = segundos / 3600;
    minutos = (segundos % 3600) / 60;
    segundosRestantes = segundos % 60;

    printf("%d:%d:%d\n\n", horas, minutos, segundosRestantes);


    /* EXERCICIO 9 */
    float tempo, velocidade, distancia, litros;

    printf("EXERCICIO 9\n");
    printf("Digite o tempo da viagem em horas: ");
    scanf("%f", &tempo);

    printf("Digite a velocidade media em km/h: ");
    scanf("%f", &velocidade);

    distancia = tempo * velocidade;
    litros = distancia / 12.0;

    printf("Litros necessarios: %.3f\n\n", litros);


    /* EXERCICIO 10 */
    int a, b, c;
    int maiorAB, maiorABC;

    printf("EXERCICIO 10\n");
    printf("Digite tres valores: ");
    scanf("%d %d %d", &a, &b, &c);

    maiorAB = (a + b + abs(a - b)) / 2;
    maiorABC = (maiorAB + c + abs(maiorAB - c)) / 2;

    printf("%d eh o maior\n", maiorABC);


    return 0;
}
